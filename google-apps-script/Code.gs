const CONFIG={notificationEmail:'connect@synergistica.in',folderName:'Synergistica Candidate CVs',sheetName:'Synergistica Website Leads'};
function doPost(e){try{const p=JSON.parse((e.parameter&&e.parameter.payload)||'{}');if(p.honey)return out({ok:true});if(!['hire','candidate'].includes(p.formType))throw new Error('Invalid form');const f=p.fields||{};const ss=getSheet_();const now=new Date();let cv='';if(p.formType==='candidate'){if(!p.file||!p.file.data)throw new Error('CV required');const bytes=Utilities.base64Decode(p.file.data);if(bytes.length>5*1024*1024)throw new Error('CV too large');const ext=(p.file.name||'').split('.').pop().toLowerCase();if(!['pdf','doc','docx'].includes(ext))throw new Error('Invalid CV type');const folder=getFolder_();const file=folder.createFile(Utilities.newBlob(bytes,p.file.type||'application/octet-stream',p.file.name));cv=file.getUrl();}
const row=[now,p.formType,f.Name||'',f.Company||'',f.email||'',f.Phone||'',f['Role required']||f['Preferred role']||'',f['Current role']||'',f.Experience||'',f['Current location']||'',f['Hiring location']||f['Preferred location']||'',f['Number of hires']||'',f['Hiring timeline']||'',f['CTC or budget range']||f.CTC||'',f['Notice period']||'',f['Profile link']||'',f['Requirement details']||f['Candidate notes']||'',cv];ss.appendRow(row);const subject=p.formType==='hire'?'New Synergistica hiring requirement':'New Synergistica candidate submission';const lines=Object.keys(f).filter(k=>f[k]).map(k=>k+': '+f[k]);if(cv)lines.push('CV: '+cv);MailApp.sendEmail(CONFIG.notificationEmail,subject,lines.join('\n'));return out({ok:true});}catch(err){return out({ok:false,error:String(err.message||err)});}}
function getSheet_(){const files=DriveApp.getFilesByName(CONFIG.sheetName);let book;if(files.hasNext())book=SpreadsheetApp.open(files.next());else{book=SpreadsheetApp.create(CONFIG.sheetName);book.getSheets()[0].appendRow(['Timestamp','Type','Name','Company','Email','Phone','Role','Current Role','Experience','Current Location','Hiring/Preferred Location','Hires','Timeline','CTC/Budget','Notice Period','Profile','Details','CV']);}return book.getSheets()[0];}
function getFolder_(){const fs=DriveApp.getFoldersByName(CONFIG.folderName);return fs.hasNext()?fs.next():DriveApp.createFolder(CONFIG.folderName);}
function out(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);}
